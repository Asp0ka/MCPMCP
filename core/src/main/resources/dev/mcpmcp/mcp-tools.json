    {
      "name": "observe",
      "description": "优先结构化观测：player/state/inventory/equipment/container/recipes/blocks/entities/screen；blocks支持min/max或radius、block精确ID过滤、detail、include_air、limit、offset，limit是扫描候选预算而非命中条数，空页仍按next_offset续查；entities/screen按next_cursor续查。先局部粗查，再目标细查、分页和错误诊断。截图识图仅作最后手段：结构化路径无法解答具体视觉问题才用screenshot，按需最小区域；不得例行识别地形/HUD/背包或为一次动作失败直接截图。客户端缺失信息保留unknown。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
